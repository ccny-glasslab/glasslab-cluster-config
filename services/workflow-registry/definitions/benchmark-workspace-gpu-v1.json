{
  "workflow_id": "benchmark-workspace-gpu-v1",
  "display_name": "Benchmark Workspace GPU v1",
  "workflow_family": "research-workspace",
  "description": "Execute a digest-pinned ML benchmark task and Beaker source bundle in a bounded single-GPU workspace.",
  "required_inputs": [
    {
      "name": "workspace",
      "input_type": "artifact_bundle",
      "required": true,
      "description": "Immutable task and source bundle references plus the normalized command."
    },
    {
      "name": "dataset_bindings",
      "input_type": "artifact_bundle",
      "required": true,
      "description": "Digest-pinned read-only benchmark datasets."
    }
  ],
  "allowed_models": ["agent-generated-python"],
  "runner_image": "ghcr.io/ccny-glasslab/glasslab-research-workspace-runner@sha256:9e7c18d186108847a485ab955194ced2dceee3ed8c8a624a2b0f3ee0e7628b60",
  "runner_service_account_name": "glasslab-gpu-runner",
  "max_wallclock_minutes": 240,
  "evaluator_type": "immutable-benchmark-contract-v1",
  "expected_artifacts": {
    "required": [
      "run_manifest.json",
      "config.json",
      "metrics.json",
      "evaluation.json",
      "artifacts_index.json",
      "report.md",
      "status.json",
      "logs/",
      "source.zip"
    ],
    "optional": ["task.zip", "plots/", "tables/", "environment.json", "checkpoints/"]
  },
  "resource_profile": {
    "profile_name": "gpu-benchmark-single",
    "requests": {
      "cpu": "2",
      "memory": "8Gi",
      "ephemeral-storage": "4Gi",
      "nvidia.com/gpu": "1"
    },
    "limits": {
      "cpu": "8",
      "memory": "32Gi",
      "ephemeral-storage": "16Gi",
      "nvidia.com/gpu": "1"
    },
    "node_selector": {"glasslab.io/gpu-candidate": "true"}
  },
  "approval_tier": "tier-3-human-approval",
  "execution_status": "ready",
  "submission_backend": "kubernetes",
  "execution_blockers": [],
  "runtime_requirements": {
    "gpu": true,
    "required_python_packages": [
      "torch",
      "torchvision",
      "numpy",
      "pandas",
      "scipy",
      "scikit-learn",
      "matplotlib"
    ],
    "modalities": ["image", "representation-learning"],
    "dataset_layouts": ["archive"],
    "purpose": "bounded single-GPU benchmark execution"
  },
  "experiment_type": "research-workspace-job",
  "workload_id": "benchmark-workspace-gpu-v1",
  "schema_ref": "glasslab-benchmark-workspace-v1",
  "default_entrypoint": ["python3", "-m", "runner"],
  "metric_contract": {
    "primary_metric": "rubric_score",
    "higher_is_better": true,
    "required_guardrails": ["integrity_pass"]
  }
}
