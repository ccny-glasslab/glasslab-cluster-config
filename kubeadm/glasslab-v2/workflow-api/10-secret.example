# Documentation-only schema. This file is intentionally not a deployable
# Kubernetes Secret.
secret_contract:
  api_version: v1
  resource_kind: Secret
  metadata:
    name: glasslab-v2-workflow-api
    namespace: glasslab-v2
  required_keys:
    - GLASSLAB_WORKFLOW_API_STORE_POSTGRES_DSN
  example_values_are_not_deployable: true
---
# Caller tokens are separate SOPS-managed Secrets. workflow-api reads the two
# active callers' tokens, while each caller receives only its own token. The
# retired research-command-router caller was removed in #289; its secret name
# is intentionally absent here.
caller_secret_contract:
  namespace: glasslab-v2
  secrets:
    - name: glasslab-workflow-api-schedule-worker
      required_keys: [token]
    - name: glasslab-workflow-api-research-orchestrator
      required_keys: [token]
  example_values_are_not_deployable: true
