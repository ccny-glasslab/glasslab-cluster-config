# Documentation-only schema. This file is intentionally not a deployable
# Kubernetes Secret.
secret_contract:
  api_version: v1
  resource_kind: Secret
  metadata:
    name: glasslab-v2-workflow-api
    namespace: glasslab-v2
  required_keys:
    - GLASSLAB_WORKFLOW_API_STORE_POSTGRES_DSN
  example_values_are_not_deployable: true
---
# Caller tokens are separate SOPS-managed Secrets. workflow-api reads the two
# active callers' tokens, while each caller receives only its own token. The
# retired research-command-router caller was removed in #289; its secret name
# is intentionally absent here.
caller_secret_contract:
  namespace: glasslab-v2
  secrets:
    - name: glasslab-workflow-api-schedule-worker
      required_keys: [token]
    - name: glasslab-workflow-api-research-orchestrator
      required_keys: [token]
  example_values_are_not_deployable: true
---
# Object-store identity for workflow-api when source-document storage is set to
# `minio`. It is a bucket-scoped MinIO user, not the root identity, and lives
# in its own Secret so a leaked root credential is never mounted into the
# long-lived service. Provision it with the one-shot Job in
# kubeadm/glasslab-v2/minio/45-provision-scoped-users-job.yaml; see
# docs/glasslab-v2/runbooks/provision-minio-scoped-users.md.
minio_secret_contract:
  api_version: v1
  resource_kind: Secret
  metadata:
    name: glasslab-v2-workflow-api-minio
    namespace: glasslab-v2
  required_keys:
    - MINIO_ACCESS_KEY
    - MINIO_SECRET_KEY
  example_values_are_not_deployable: true
